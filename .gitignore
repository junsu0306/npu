# Local environments, caches and archives (never submission artifacts).
/.venv*/
/venv/
/env/
/aries_env/
/.tools/
/.vscode/
/past/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
*.log
*.whl
*.egg-info/
compile/**/calib_*.txt

